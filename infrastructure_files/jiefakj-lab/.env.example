# 先 cp .env.example .env,再填三密钥与真实域名/IP:
#   NETBIRD_RELAY_AUTH_SECRET 用 openssl rand -hex 24
#   TURN_PASSWORD 用 openssl rand -hex 16
#   NETBIRD_DATASTORE_ENC_KEY 用 openssl rand -base64 32
# 然后据 TURN_PASSWORD 生成 turnserver.conf(见 turnserver.conf.example)。
NETBIRD_RELAY_AUTH_SECRET=replace-with-openssl-rand-hex-24
TURN_PASSWORD=replace-with-openssl-rand-hex-16
NETBIRD_DATASTORE_ENC_KEY=replace-with-openssl-rand-base64-32
# 单账户模式根域名(--single-account-mode-domain)
NETBIRD_DOMAIN=example.com
# Authentik 主机名
AUTH_DOMAIN=auth.example.com
# extra_hosts 钉死的 IdP IP(绕过宿主 fake-IP DNS)
AUTH_DOMAIN_IP=203.0.113.10
# EasyAuth 主机名,用于 NB_BLOCKED_USER_MESSAGE
IAM_DOMAIN=iam.example.com
# ak_device_login.py 基址
AUTH_BASE_URL=https://auth.example.com
