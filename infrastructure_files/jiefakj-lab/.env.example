# 复制为 .env 后填入随机密钥:
#   cd infrastructure_files/jiefakj-lab
#   printf 'NETBIRD_RELAY_AUTH_SECRET=%s\nTURN_PASSWORD=%s\nNETBIRD_DATASTORE_ENC_KEY=%s\n' \
#     "$(openssl rand -hex 24)" "$(openssl rand -hex 16)" "$(openssl rand -base64 32)" > .env
# 然后据 TURN_PASSWORD 生成 turnserver.conf(见 turnserver.conf.example)。
NETBIRD_RELAY_AUTH_SECRET=replace-with-openssl-rand-hex-24
TURN_PASSWORD=replace-with-openssl-rand-hex-16
NETBIRD_DATASTORE_ENC_KEY=replace-with-openssl-rand-base64-32
